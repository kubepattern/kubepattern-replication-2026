# Pinned versions for the KubePattern evaluation (sourced by every script).
# Platform versions were verified against upstream release assets in September 2026.

# --- Cluster ---
# Overridable from the environment (e.g. the Krateo case study runs on profile kp-krateo).
: "${KP_PROFILE:=kp-eval}"
: "${KUBERNETES_VERSION:=v1.34.4}"
: "${MINIKUBE_CPUS:=8}"
: "${MINIKUBE_MEMORY:=16g}"
: "${MINIKUBE_DISK:=80g}"

# --- KubePattern under test ---
# Source tree of the engine (chart, CRDs, git history for the builds): the submodule
# kubepattern/ by default, or any clone of https://github.com/kubepattern/kubepattern.
: "${KP_SRC:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/kubepattern}"
# Default: the engine evaluated as-is. Override KP_COMMIT (e.g. the per-pattern prune fix)
# to build, install and measure another engine version with the same scripts.
: "${KP_COMMIT:=69d4ffd}"
: "${KP_IMAGE:=localhost/kubepattern:eval-${KP_COMMIT}}"
: "${KP_BIN:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/kubepattern-${KP_COMMIT}}"
KP_NAMESPACE=kubepattern
KP_RELEASE=kubepattern
KP_SA=system:serviceaccount:kubepattern:kubepattern-sa

# Engine labels -> public commits of github.com/kubepattern/kubepattern. The measurements
# use the labels (image tags, binaries, folders). 69d4ffd, a814e4a and 54dc498 are SHAs from
# before the history rewrite of 2026-10-08; their public commits have the same tree. wp0 is
# the client QPS + linter change of chore/engine-cleanup. Other values pass through.
kp_ref() {
  case "$1" in
    69d4ffd) echo 16afa6a ;;  # as-is engine of the main results
    a814e4a) echo 0a51e7a ;;  # per-pattern Smell prune
    wp0)     echo b4df203 ;;  # prune + client QPS 50/100 + linter
    54dc498) echo 24f288a ;;  # engine update: QPS, linter, spec.for
    *)       echo "$1" ;;
  esac
}

# --- Subject platforms ---
CERT_MANAGER_VERSION=v1.21.2
CNPG_VERSION=1.30.1
ESO_CHART_VERSION=2.11.0
FLUX_VERSION=v2.9.5
ARGOCD_CHART_VERSION=10.9.2
KARGO_VERSION=1.11.4
CROSSPLANE_VERSION=2.4.2
KUBEVELA_VERSION=1.11.0
CAPI_VERSION=v1.14.2

# --- RQ6 comparison baseline (installed only by env/install/95-kyverno.sh) ---
KYVERNO_CHART_VERSION=3.9.1   # Kyverno v1.19.1
KYVERNO_NAMESPACE=kyverno
